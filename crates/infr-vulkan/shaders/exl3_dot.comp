#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_control_flow_attributes : require
#ifdef USE_F16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif
#ifdef SHUFFLE
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#endif
#ifndef B_ROWS
#define B_ROWS 1
#endif
#ifndef K_SLICES
#define K_SLICES 8
#endif
#define WG (K_SLICES * 32u)
layout(local_size_x = WG) in;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Trellis { uint v[]; };
layout(binding = 0) readonly buffer XB { float x[]; };
layout(binding = 1) writeonly buffer YB { float y[]; };
layout(push_constant) uniform PC {
    uint rows; uint in_f; uint out_f; uint bits;
    uint trellis_lo; uint trellis_hi; uint codebook;
} pc;
shared float red[B_ROWS * 2u * WG];

float half_rne(float value) {
    uint u = floatBitsToUint(value);
    return uintBitsToFloat((u + 0xfffu + ((u >> 13u) & 1u)) & ~0x1fffu);
}

float decode(uint w) {
    if (pc.codebook == 2u) {
        uint h = w * 0x83dcd12du;
        uint sum = 0x6400u + (h & 255u) + ((h >> 8u) & 255u) + ((h >> 16u) & 255u) + (h >> 24u);
        float value = unpackHalf2x16(sum).x;
        return half_rne(value * unpackHalf2x16(0x1eeeu).x + unpackHalf2x16(0xc931u).x);
    }
    uint h = pc.codebook == 0u ? w * 89226354u + 64248484u : w * 0xcbac1fedu;
    h = (h & 0x8fff8fffu) ^ 0x3b603b60u;
#ifdef USE_F16
    f16vec2 hv = unpackFloat2x16(h);
    return float(hv.x + hv.y);
#else
    vec2 halves = unpackHalf2x16(h);
    return half_rne(halves.x + halves.y);
#endif
}

uint funnel(uint a, uint b, uint sh) {
    return (a << sh) | ((b >> 1u) >> (31u - sh));
}

void main() {
    uint unit = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint n_tiles = pc.out_f / 16u;
    if (unit >= ((pc.rows + B_ROWS - 1u) / B_ROWS) * n_tiles) { return; }
    uint row0 = (unit / n_tiles) * B_ROWS;
    uint tile = unit % n_tiles;
#ifdef SHUFFLE
    uint lane = gl_SubgroupInvocationID & 31u;
    uint slice = gl_SubgroupID * (gl_SubgroupSize >> 5u) + (gl_SubgroupInvocationID >> 5u);
    uint sbase = gl_SubgroupInvocationID & ~31u;
    uint t = slice * 32u + lane;
#else
    uint t = gl_LocalInvocationID.x;
    uint lane = t & 31u;
    uint slice = t >> 5u;
#endif
    uint r0 = 2u * (lane & 3u);
    uint c0 = 2u * (lane >> 3u) + ((lane >> 2u) & 1u);
    uint64_t addr = (uint64_t(pc.trellis_hi) << 32) | uint64_t(pc.trellis_lo);
#ifdef BITS
    const uint nbits = uint(BITS);
    // 8*lane*bits is a multiple of 32 when bits % 4 == 0, so the bit offset is lane-invariant.
    const uint off = (nbits % 4u == 0u) ? ((nbits + 1024u - 16u) & 31u) : 0u;
#else
    uint nbits = pc.bits;
#endif
    uint words = 8u * nbits;
    uint total = 256u * nbits;
    uint start = ((8u * lane + 1u) * nbits + total - 16u) % total;
    uint w0 = start >> 5u;
#ifndef BITS
    uint off = start & 31u;
#endif
    uint i1 = w0 + 1u >= words ? w0 + 1u - words : w0 + 1u;
    uint i2 = i1 + 1u >= words ? i1 + 1u - words : i1 + 1u;
    uint i3 = i2 + 1u >= words ? i2 + 1u - words : i2 + 1u;
    float acc_lo[B_ROWS];
    float acc_hi[B_ROWS];
    for (uint r = 0u; r < B_ROWS; ++r) { acc_lo[r] = 0.0; acc_hi[r] = 0.0; }
    uint k_tiles = pc.in_f / 16u;
#ifdef SHUFFLE
    bool two = words > 32u;
    uint ca = 0u, cb = 0u;
    if (slice < k_tiles) {
        uint base = (slice * n_tiles + tile) * words;
        if (lane < words) { ca = Trellis(addr).v[base + lane]; }
        if (two && lane + 32u < words) { cb = Trellis(addr).v[base + 32u + lane]; }
    }
#endif
    for (uint ki = slice; ki < k_tiles; ki += K_SLICES) {
#ifdef SHUFFLE
        uint na = 0u, nb = 0u;
        uint kn = ki + K_SLICES;
        if (kn < k_tiles) {
            uint nbase = (kn * n_tiles + tile) * words;
            if (lane < words) { na = Trellis(addr).v[nbase + lane]; }
            if (two && lane + 32u < words) { nb = Trellis(addr).v[nbase + 32u + lane]; }
        }
        uint a0 = subgroupShuffle(ca, sbase + (w0 & 31u));
        uint a1 = subgroupShuffle(ca, sbase + (i1 & 31u));
        uint a2 = subgroupShuffle(ca, sbase + (i2 & 31u));
        uint a3 = subgroupShuffle(ca, sbase + (i3 & 31u));
        if (two) {
            uint b0 = subgroupShuffle(cb, sbase + (w0 & 31u));
            uint b1 = subgroupShuffle(cb, sbase + (i1 & 31u));
            uint b2 = subgroupShuffle(cb, sbase + (i2 & 31u));
            uint b3 = subgroupShuffle(cb, sbase + (i3 & 31u));
            a0 = w0 >= 32u ? b0 : a0;
            a1 = i1 >= 32u ? b1 : a1;
            a2 = i2 >= 32u ? b2 : a2;
            a3 = i3 >= 32u ? b3 : a3;
        }
        ca = na;
        cb = nb;
#else
        uint base = (ki * n_tiles + tile) * words;
        uint a0 = Trellis(addr).v[base + w0];
        uint a1 = Trellis(addr).v[base + i1];
        uint a2 = Trellis(addr).v[base + i2];
        uint a3 = Trellis(addr).v[base + i3];
#endif
        float wv[8];
        [[unroll]] for (uint e = 0u; e < 8u; ++e) {
            uint p = off + e * nbits;
            uint q = p >> 5u;
            uint hi = q == 0u ? a0 : (q == 1u ? a1 : a2);
            uint lo = q == 0u ? a1 : (q == 1u ? a2 : a3);
            wv[e] = decode(funnel(hi, lo, p & 31u) >> 16u);
        }
        [[unroll]] for (uint r = 0u; r < B_ROWS; ++r) {
            if (row0 + r < pc.rows) {
                uint xb = (row0 + r) * pc.in_f + ki * 16u + r0;
                float x0 = x[xb], x1 = x[xb + 1u], x8 = x[xb + 8u], x9 = x[xb + 9u];
                acc_lo[r] += x0 * wv[0] + x1 * wv[1] + x8 * wv[2] + x9 * wv[3];
                acc_hi[r] += x0 * wv[4] + x1 * wv[5] + x8 * wv[6] + x9 * wv[7];
            }
        }
    }
    for (uint r = 0u; r < B_ROWS; ++r) {
        red[r * 2u * WG + t] = acc_lo[r];
        red[r * 2u * WG + WG + t] = acc_hi[r];
    }
    barrier();
    if (t < 16u) {
        uint c = t;
        uint half_sel = c >> 3u;
        uint cl = c & 7u;
        uint lane_base = 8u * (cl >> 1u) + 4u * (cl & 1u);
        [[unroll]] for (uint r = 0u; r < B_ROWS; ++r) {
            float s = 0.0;
            for (uint sl = 0u; sl < K_SLICES; ++sl) {
                for (uint j = 0u; j < 4u; ++j) {
                    s += red[r * 2u * WG + half_sel * WG + sl * 32u + lane_base + j];
                }
            }
            if (row0 + r < pc.rows) { y[(row0 + r) * pc.out_f + tile * 16u + c] = s; }
        }
    }
}
